{
  "$schema": "./frontend/node_modules/wrangler/config-schema.json",
  "name": "qred",
  "compatibility_date": "2026-06-22",
  "main": "./frontend/worker/index.js",
  "assets": {
    "directory": "./frontend/build",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "QRED_DEFAULT_PUBLIC_KEY": "",
    "QRED_DEFAULT_KEY_ID": "",
    "QRED_ORIGIN": "https://qred.org",
    "QRED_GOOGLE_CLIENT_ID": "21775093456-tqmg3efc48kspnau7k9rj2vm4ksvq6pn.apps.googleusercontent.com",
    "QRED_ATTESTATION_KEY_ID": "477eb945edeca1a8"
  },
  "triggers": {
    "crons": []
  }
}
